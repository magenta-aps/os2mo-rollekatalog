#!/usr/bin/env bash

set -eo pipefail

printf "Sleeping for Rollekatalog, this could take a while...\n";
until curl --silent --output /dev/null http://localhost:8090/; do
    sleep 1;
done

# Since Rollekatalog 2026-08-24, API keys must be registered as clients in
# its database; the rc.customer.apikey environment variable alone no longer
# authorizes API calls. Lookups are cached, including misses, so Rollekatalog
# is restarted after registering.
if ! docker compose exec -T maria mariadb -urollekatalog -pTest1234 rollekatalog -N \
        -e "SELECT 1 FROM client WHERE api_key = '00000000-0000-4000-0000-000000000000'" | grep -q 1; then
    printf "Registering the integration's API client in Rollekatalog\n";
    docker compose exec -T maria mariadb -urollekatalog -pTest1234 rollekatalog \
        -e "INSERT INTO client (name, api_key, access_role) VALUES ('os2mo', '00000000-0000-4000-0000-000000000000', 'ADMINISTRATOR')";
    docker compose restart rollekatalog;
    printf "Waiting for Rollekatalog to come back up\n";
    until curl --silent --output /dev/null http://localhost:8090/; do
        sleep 1;
    done
fi

# There is no migration framework: create_all() adds new tables but not new
# columns, so an existing database needs this by hand. Same DDL as the deploy.
printf "Ensuring the user.itsystem_user_key column exists\n";
docker compose exec -T db psql -q -U rollekatalog -d rollekatalog \
    -c 'ALTER TABLE "user" ADD COLUMN IF NOT EXISTS itsystem_user_key VARCHAR';

# The domain named in ITSYSTEM_DOMAINS must exist in Rollekatalog, or the
# import returns 404. Flyway seeds only the primary domain, "Administrativt".
if ! docker compose exec -T maria mariadb -urollekatalog -pTest1234 rollekatalog -N \
        -e "SELECT 1 FROM domains WHERE name = 'Skole'" | grep -q 1; then
    printf "Creating the Skole domain in Rollekatalog\n";
    docker compose exec -T maria mariadb -urollekatalog -pTest1234 rollekatalog \
        -e "INSERT INTO domains (name) VALUES ('Skole')";
fi

REALM="mo"
BASEURL="http://localhost:5000/auth"
TOKEN_URL="${BASEURL}/realms/${REALM}/protocol/openid-connect/token"
CLIENT_ID="dipex"
CLIENT_SECRET="603f1c82-d012-4d04-9382-dbe659c533fb"
GRAPHQL_URL="http://localhost:5000/graphql/v25"

# --- Helper Function for GraphQL ---
# Arguments: $1 = GraphQL Query String
run_graphql() {
    local QUERY="$1"
    local PAYLOAD

    # Safely create JSON payload using jq
    PAYLOAD=$(jq -n --arg q "$QUERY" '{query: $q}')

    printf "Sending GraphQL Mutation...\n"

    # Run curl, capture response
    local RESPONSE
    RESPONSE=$(curl -s -X POST "${GRAPHQL_URL}" \
      -H "Authorization: bearer ${TOKEN}" \
      -H "Content-Type: application/json" \
      -d "$PAYLOAD")

    # Check if the response contains "errors"
    # We use printf "%s" to pipe the variable safely into jq
    if printf "%s" "$RESPONSE" | jq -e '.errors' > /dev/null; then
        printf "Error in GraphQL response:\n"
        printf "%s" "$RESPONSE" | jq .
        exit 1
    fi

    printf "%s" "$RESPONSE" | jq '.'
}

printf "Requesting Token...\n"

AUTH_RESPONSE=$(curl -s -X POST "${TOKEN_URL}" \
  -d "grant_type=client_credentials" \
  -d "client_id=${CLIENT_ID}" \
  -d "client_secret=${CLIENT_SECRET}")

# Extract token using printf to pipe safely to jq
TOKEN=$(printf "%s" "$AUTH_RESPONSE" | jq -r '.access_token')

if [ "$TOKEN" == "null" ] || [ -z "$TOKEN" ]; then
  printf "Error fetching token:\n"
  printf "%s" "$AUTH_RESPONSE" | jq .
  exit 1
fi
printf "Token received.\n"


# Mutation 1: Update AD IT-User
MUTATION_1='
mutation {
  ituser_update(
    input: {
      uuid: "7e92809a-ad18-44b1-a521-3158ee64c7f7"
      validity: {from: "1997-09-13"}
      engagement: "9a850987-0dda-4f98-8e22-c6267d4834c5"
      external_id: "3c6c1b1f-a697-449f-9479-4d86fbb5a3b7"
    }
  ) {
    uuid
  }
}
'

# Mutation 2: Update FK IT-User
MUTATION_2='
mutation {
  ituser_update(
    input: {
      uuid: "70827886-040b-4897-b138-3247f4291753"
      validity: {from: "1997-09-13"}
      user_key: "3c6c1b1f-a697-449f-9479-4d86fbb5a3b7"
      external_id: "5028c151-0919-4452-8220-fa8d32f00fe2"
    }
  ) {
    uuid
  }
}
'

printf "Executing Mutation 1 (AD)\n"
run_graphql "$MUTATION_1"

printf "Executing Mutation 2 (FK) \n"
run_graphql "$MUTATION_2"

# Ludvig's second AD account, for the Skole domain. Each AD account needs its
# own FK account: the AD ituser's external_id must match an FK ituser's
# user_key, and that FK ituser's external_id becomes the extUuid. Without the
# FK partner the account resolves to no extUuid and is skipped entirely.
SKOLE_AD_ITUSER="b0b0b0b0-0000-4000-8000-000000000001"
SKOLE_FK_ITUSER="b0b0b0b0-0000-4000-8000-000000000002"
SKOLE_LINK="e1e1e1e1-0000-4000-8000-000000000002"
SKOLE_EXTUUID="f2f2f2f2-0000-4000-8000-000000000002"
AD_ITSYSTEM="a1608e69-c422-404f-a6cc-b873c50af111"
FK_ITSYSTEM="5168dd45-4cb5-4932-b8a1-10dbe736fc5d"
LUDVIG="4e7e5443-09a9-4a46-8cd5-f7bcefeb2902"
ENGAGEMENT="9a850987-0dda-4f98-8e22-c6267d4834c5"

ituser_exists() {
    curl -s -X POST "${GRAPHQL_URL}" \
      -H "Authorization: bearer ${TOKEN}" \
      -H "Content-Type: application/json" \
      -d "$(jq -n --arg q "{ itusers(filter: {uuids: [\"$1\"]}) { objects { uuid } } }" '{query: $q}')" \
      | jq -r '.data.itusers.objects | length'
}

ensure_ituser() {
    if [ "$(ituser_exists "$1")" = "0" ]; then
        run_graphql "mutation { ituser_create(input: {uuid: \"$1\", user_key: \"$2\", itsystem: \"$3\", person: \"${LUDVIG}\", engagements: [\"${ENGAGEMENT}\"], external_id: \"$4\", validity: {from: \"1997-09-13\"}}) { uuid } }"
    else
        run_graphql "mutation { ituser_update(input: {uuid: \"$1\", user_key: \"$2\", external_id: \"$4\", validity: {from: \"1997-09-13\"}}) { uuid } }"
    fi
}

printf "Ensuring Ludvig's second AD account (Skole) and its FK account\n"
ensure_ituser "${SKOLE_AD_ITUSER}" "LudvigH-skole" "${AD_ITSYSTEM}" "${SKOLE_LINK}"
ensure_ituser "${SKOLE_FK_ITUSER}" "${SKOLE_LINK}" "${FK_ITSYSTEM}" "${SKOLE_EXTUUID}"

printf "GraphQL adjustments completed.\n"

printf "Requesting sync of Ludvigs OU\n"
syncorg=$(curl -s -X POST 'http://localhost:8000/sync/org_unit/7a8e45f7-4de0-44c8-990f-43c0565ee505')
if [ "$syncorg" != "null" ]; then
    printf "Sync OU failed. Integration returned: %s\n" "$syncorg"
    exit 1;
fi

printf "Requesting sync of Ludvig\n"
syncperson=$(curl -s -X POST 'http://localhost:8000/sync/person/4e7e5443-09a9-4a46-8cd5-f7bcefeb2902')
if [ "$syncperson" != "null" ]; then
    printf "Sync person failed. Integration returned: %s\n" "$syncperson"
    exit 1;
fi

printf "Waiting 15 seconds for sync\n"
sleep 15

printf 'Assigning "Administrator" to Ludvig in Rollekatalog\n'
curl -X PUT -H 'ApiKey: 00000000-0000-4000-0000-000000000000' 'http://localhost:8090/api/user/LudvigH/assign/userrole/1'

printf "\nLudvig's two accounts and their domains:\n"
curl -s 'http://localhost:8000/cache/person/4e7e5443-09a9-4a46-8cd5-f7bcefeb2902' \
  | jq -r '.[] | "  \(.userId)\t\(.itsystem_user_key)"'
printf "Users per domain in Rollekatalog:\n"
docker compose exec -T maria mariadb -urollekatalog -pTest1234 rollekatalog -N \
    -e "SELECT CONCAT('  ', d.name, ': ', u.user_id) FROM users u JOIN domains d ON u.domain_id = d.id"

printf "You should now be able to log in to http://localhost:8090 with ludvig:ludvig\n"
printf "This is Ludvig in OS2mo: http://localhost:5000/employee/4e7e5443-09a9-4a46-8cd5-f7bcefeb2902#ituser\n"
